{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docker-dev.local/schemas/command.schema.json",
  "title": "docker-dev command",
  "description": "Declarative command executed by docker-dev's constrained command runner.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "name", "usage", "summary", "help", "steps"],
  "properties": {
    "schema": { "const": "docker-dev/command/v1" },
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "usage": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "help": { "type": "string", "minLength": 1 },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["call"],
      "properties": {
        "call": {
          "type": "object",
          "additionalProperties": false,
          "required": ["function"],
          "properties": {
            "function": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
            "args": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
