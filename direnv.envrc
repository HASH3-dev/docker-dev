# The root .envrc is a symlink created by `./.docker-dev/dev.sh setup`.
# Enabled plugins may provide host wrappers without coupling the core kit to a
# language or package manager. This reads only controlled local configuration.
plugins_file="${PWD}/.docker-dev/plugins.enabled"

if [[ -f "$plugins_file" ]]; then
  while IFS= read -r plugin_id || [[ -n "$plugin_id" ]]; do
    plugin_id="${plugin_id#"${plugin_id%%[![:space:]]*}"}"
    plugin_id="${plugin_id%"${plugin_id##*[![:space:]]}"}"
    [[ -z "$plugin_id" || "$plugin_id" == \#* ]] && continue
    plugin_host_bin="${PWD}/.docker-dev/plugins/${plugin_id}/host-bin"
    [[ -d "$plugin_host_bin" ]] && PATH_add "$plugin_host_bin"
    plugin_manifest="${PWD}/.docker-dev/plugins/${plugin_id}/plugin.yml"
    plugins_path="$(sed -n 's/^plugins_path:[[:space:]]*//p' "$plugin_manifest" | head -n 1 | sed 's/^"//; s/"$//')"
    plugins_enabled_file="$(sed -n 's/^plugins_enabled_file:[[:space:]]*//p' "$plugin_manifest" | head -n 1 | sed 's/^"//; s/"$//')"
    [[ -n "$plugins_path" && -z "$plugins_enabled_file" ]] && plugins_enabled_file='plugins.enabled'
    subplugins_file="${PWD}/.docker-dev/plugins/${plugin_id}/${plugins_enabled_file}"
    if [[ -n "$plugins_path" && -f "$subplugins_file" ]]; then
      while IFS= read -r subplugin_id || [[ -n "$subplugin_id" ]]; do
        subplugin_id="${subplugin_id#"${subplugin_id%%[![:space:]]*}"}"
        subplugin_id="${subplugin_id%"${subplugin_id##*[![:space:]]}"}"
        [[ -z "$subplugin_id" || "$subplugin_id" == \#* ]] && continue
        [[ "$subplugin_id" =~ ^[a-z0-9][a-z0-9-]*$ ]] || continue
        subplugin_host_bin="${PWD}/.docker-dev/plugins/${plugin_id}/${plugins_path}/${subplugin_id}/host-bin"
        [[ -d "$subplugin_host_bin" ]] && PATH_add "$subplugin_host_bin"
      done < "$subplugins_file"
    fi
  done < "$plugins_file"
fi

unset plugins_file plugin_id plugin_host_bin plugin_manifest plugins_path plugins_enabled_file subplugins_file subplugin_id subplugin_host_bin
