{
  "$schema": "../../../../schemas/command.schema.json",
  "name": "secrets",
  "args": "<command> [arguments...]",
  "options": [
    {
      "flags": "--env-file <path>",
      "description": "Project-relative env file with op:// references."
    }
  ],
  "summary": "Run a command with 1Password secrets.",
  "help": "Resolve op:// references from an env file into one command's environment.",
  "steps": [
    {
      "call": {
        "function": "requireSetup"
      }
    },
    {
      "call": {
        "function": "requireCommandArguments",
        "args": ["$@"]
      }
    },
    {
      "call": {
        "function": "runSecretsWrapper",
        "args": ["$@"]
      }
    }
  ]
}
