#!/usr/bin/env bash
set -euo pipefail

env_file=""
environment=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --env-file)
      [[ $# -ge 2 ]] || { echo "Missing value for --env-file." >&2; exit 1; }
      env_file="$2"
      shift 2
      ;;
    --environment)
      [[ $# -ge 2 ]] || { echo "Missing value for --environment." >&2; exit 1; }
      environment="$2"
      shift 2
      ;;
    --)
      shift
      break
      ;;
    -*)
      echo "Unknown option: $1" >&2
      exit 1
      ;;
    *)
      break
      ;;
  esac
done

[[ -n "$env_file" || -n "$environment" ]] || {
  echo "Provide --env-file <path> and/or --environment <id>." >&2
  exit 1
}

if [[ -n "$env_file" && ! -f "$env_file" ]]; then
  echo "1Password env file not found: $env_file" >&2
  exit 1
fi

[[ $# -gt 0 ]] || { echo "Provide a command to run." >&2; exit 1; }
command -v op >/dev/null || { echo "1Password CLI is not installed. Rebuild with the 1password plugin enabled." >&2; exit 1; }

require_terminal() {
  [[ -t 0 && -t 1 ]] || {
    echo "1Password sign-in requires an interactive terminal. Run this command from a terminal first." >&2
    exit 1
  }
}

if ! accounts="$(op account list --format json)"; then
  echo "Could not inspect 1Password accounts." >&2
  exit 1
fi

if [[ "$accounts" =~ ^[[:space:]]*\[\][[:space:]]*$ ]]; then
  require_terminal
  op account add
  signin="$(op signin -f)"
  eval "$signin"
elif ! op whoami >/dev/null 2>&1; then
  require_terminal
  signin="$(op signin -f)"
  eval "$signin"
fi

op_args=(run)
[[ -n "$environment" ]] && op_args+=(--environment "$environment")
[[ -n "$env_file" ]] && op_args+=(--env-file="$env_file")
op_args+=(--no-masking --)
exec op "${op_args[@]}" "$@"
