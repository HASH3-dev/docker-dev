{
  "$schema": "../../../../schemas/plugin.schema.json",
  "name": "npm",
  "kind": "package-manager-adapter",
  "summary": "Protects npm dependency installation with the Trivy gate.",
  "requiresRuntimes": ["nodejs"],
  "detect": {
    "files": ["package.json", "package-lock.json", "npm-shrinkwrap.json"]
  },
  "container": {
    "environment": {
      "NPM_CONFIG_CACHE": "/npm-cache"
    },
    "volumes": [
      { "name": "node_modules", "target": "/workspace/node_modules" },
      { "name": "npm_cache", "target": "/npm-cache" }
    ]
  },
  "imageInstall": "image-install.sh"
}
