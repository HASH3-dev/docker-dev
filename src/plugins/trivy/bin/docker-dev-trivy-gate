#!/usr/bin/env bash
set -euo pipefail

readonly trivy_severity="${TRIVY_SEVERITY:-HIGH,CRITICAL}"

scan_target() {
  local target="$1"
  local output="${2:-}"
  local exit_code="${3:-1}"
  [[ "$exit_code" =~ ^[01]$ ]] || { echo "Trivy gate exit code must be 0 or 1." >&2; return 2; }
  [[ -e "$target" ]] || { echo "Trivy gate target not found: $target" >&2; return 2; }
  echo "Security gate: scanning with Trivy (${trivy_severity})..." >&2
  local -a options=(fs --quiet --scanners vuln --severity "$trivy_severity" --exit-code "$exit_code")
  [[ -n "$output" ]] && options+=(--format json --output "$output")
  trivy "${options[@]}" "$target"
}

scan_iac() {
  local target="$1"
  local output="$2"
  local exit_code="${3:-1}"
  [[ "$exit_code" =~ ^[01]$ ]] || { echo "Trivy gate exit code must be 0 or 1." >&2; return 2; }
  [[ -d "$target" ]] || { echo "Trivy IaC target is not a directory: $target" >&2; return 2; }
  echo "Security scan: checking Infrastructure as Code with Trivy (${trivy_severity})..." >&2
  trivy config --quiet --severity "$trivy_severity" --exit-code "$exit_code" --format json --output "$output" "$target"
}

scan_image() {
  local image="$1"
  local output="$2"
  local exit_code="${3:-1}"
  [[ "$exit_code" =~ ^[01]$ ]] || { echo "Trivy gate exit code must be 0 or 1." >&2; return 2; }
  echo "Security scan: checking image ${image} with Trivy (${trivy_severity})..." >&2
  trivy image --quiet --severity "$trivy_severity" --exit-code "$exit_code" --format json --output "$output" "$image"
}

usage() {
  cat <<'EOF'
Usage: docker-dev-trivy-gate scan-lock <path>
       docker-dev-trivy-gate scan-path <path> <output> [--exit-code=0|1]
       docker-dev-trivy-gate scan-iac <path> <output> [--exit-code=0|1]
       docker-dev-trivy-gate scan-image <image> <output> [--exit-code=0|1]

Adapter contract:
  - generate a temporary, fully resolved lockfile without running package scripts;
  - invoke `scan-lock <lockfile>` before the real package installation;
  - stop when this command exits non-zero.
EOF
}

case "${1:-}" in
  scan-lock)
    [[ $# -eq 2 ]] || { usage >&2; exit 2; }
    scan_target "$2"
    ;;
  scan-path)
    [[ $# -eq 3 || ( $# -eq 4 && "$4" =~ ^--exit-code=[01]$ ) ]] || { usage >&2; exit 2; }
    scan_target "$2" "$3" "${4#--exit-code=}"
    ;;
  scan-iac)
    [[ $# -eq 3 || ( $# -eq 4 && "$4" =~ ^--exit-code=[01]$ ) ]] || { usage >&2; exit 2; }
    scan_iac "$2" "$3" "${4#--exit-code=}"
    ;;
  scan-image)
    [[ $# -eq 3 || ( $# -eq 4 && "$4" =~ ^--exit-code=[01]$ ) ]] || { usage >&2; exit 2; }
    scan_image "$2" "$3" "${4#--exit-code=}"
    ;;
  --help|-h|help) usage ;;
  *) usage >&2; exit 2 ;;
esac
