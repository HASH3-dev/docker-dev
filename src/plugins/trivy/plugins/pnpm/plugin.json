{
  "$schema": "../../../../schemas/plugin.schema.json",
  "name": "pnpm",
  "kind": "package-manager-adapter",
  "summary": "Protects pnpm dependency installation with the Trivy gate.",
  "requiresRuntimes": ["nodejs"],
  "detect": {
    "files": ["package.json", "pnpm-lock.yaml", "pnpm-workspace.yaml"]
  },
  "container": {
    "volumes": [{ "name": "node_modules", "target": "/workspace/node_modules" }]
  }
}
