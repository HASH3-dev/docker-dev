{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docker-dev.local/schemas/plugin/v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "kind", "summary"],
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "kind": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "requiresRuntimes": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
      "uniqueItems": true
    },
    "configPath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._/-]+$"
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file"],
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._/-]+$"
        },
        "shared": { "type": "boolean" }
      }
    },
    "detect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files"],
      "properties": {
        "files": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+$" },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "container": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "environment": {
          "type": "object",
          "propertyNames": { "pattern": "^[A-Z_][A-Z0-9_]*$" },
          "additionalProperties": { "type": "string" }
        },
        "volumes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "target"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
              "target": { "type": "string", "pattern": "^/[A-Za-z0-9._/-]+$" }
            }
          }
        }
      }
    },
    "hooks": { "type": "object", "additionalProperties": { "type": "string" } }
  }
}
