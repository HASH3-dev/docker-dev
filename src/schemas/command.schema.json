{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docker-dev.local/schemas/command/v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "summary", "help", "steps"],
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "args": {
      "type": "string",
      "pattern": "^(?:<[^<>\\s]+>|\\[[^\\[\\]\\s]+\\])(?: (?:<[^<>\\s]+>|\\[[^\\[\\]\\s]+\\]))*$"
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["flags", "description"],
        "properties": {
          "flags": { "type": "string", "minLength": 2 },
          "description": { "type": "string", "minLength": 1 },
          "defaultValue": {
            "anyOf": [{ "type": "string" }, { "type": "boolean" }]
          }
        }
      }
    },
    "summary": { "type": "string", "minLength": 1 },
    "help": { "type": "string", "minLength": 1 },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["call"],
        "properties": {
          "call": {
            "type": "object",
            "additionalProperties": false,
            "required": ["function"],
            "properties": {
              "function": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "args": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    }
  }
}
