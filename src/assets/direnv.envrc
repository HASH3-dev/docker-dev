# The root .envrc sources this controlled file after docker-dev setup.

manifest_value() {
  local manifest="$1" key="$2"
  sed -n "s/.*\"${key}\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" "$manifest" | head -n 1
}

add_plugin_bins() {
  local directory="$1" enabled_file="$2" plugin_id manifest child_directory child_file
  [[ -f "$enabled_file" ]] || return 0

  while IFS= read -r plugin_id || [[ -n "$plugin_id" ]]; do
    plugin_id="${plugin_id#"${plugin_id%%[![:space:]]*}"}"
    plugin_id="${plugin_id%"${plugin_id##*[![:space:]]}"}"
    [[ -z "$plugin_id" || "$plugin_id" == \#* ]] && continue

    manifest="$directory/$plugin_id/plugin.json"
    [[ -f "$manifest" ]] || continue
    [[ -d "$directory/$plugin_id/host-bin" ]] && PATH_add "$directory/$plugin_id/host-bin"

    child_directory="$(manifest_value "$manifest" directory)"
    [[ -n "$child_directory" ]] || continue
    child_file="$(manifest_value "$manifest" enabledFile)"
    child_file="${child_file:-plugins.enabled}"
    add_plugin_bins "$directory/$plugin_id/$child_directory" "$directory/$plugin_id/$child_file"
  done < "$enabled_file"
}

add_plugin_bins "${PWD}/.docker-dev/plugins" "${PWD}/.docker-dev/plugins/plugins.enabled"

unset -f manifest_value add_plugin_bins
